{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": ["./src/*"],
      "@abhiramkrishna/spacetime-grid": ["../../packages/spacetime-grid/src/index.ts"],
      "@abhiramkrishna/spacetime-grid/*": ["../../packages/spacetime-grid/src/*/index.ts"],
      "@abhiramkrishna/contribution-skyline": ["../../packages/contribution-skyline/src/index.ts"],
      "@abhiramkrishna/contribution-skyline/*": ["../../packages/contribution-skyline/src/*/index.ts"]
    }
  }
}
