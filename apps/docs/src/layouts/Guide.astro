---
import type { MarkdownHeading } from "astro";
import { ArrowLeft, ArrowRight, ChevronDown } from "lucide-react";
import Site from "@/layouts/Site.astro";
import { flatten, getGuideNav, type NavItem } from "@/lib/guides";

interface Props {
  title: string;
  description?: string;
  headings: MarkdownHeading[];
  tableOfContents?: boolean;
}

const { title, description, headings, tableOfContents = true } = Astro.props;
const pathname = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const nav = await getGuideNav();
const flat = flatten(nav);
const index = flat.findIndex((item) => item.href === pathname);
const previous = index > 0 ? flat[index - 1] : undefined;
const next = index >= 0 ? flat[index + 1] : undefined;
const section = nav.find((candidate) => candidate.items.concat(candidate.frameworks).some((item) => item.href === pathname));
const toc = tableOfContents ? headings.filter((heading) => heading.depth === 2 || heading.depth === 3) : [];

const link = (item: NavItem): string[] => [
  "block rounded-md px-2.5 py-1.5 text-sm transition-colors focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none",
  item.href === pathname ? "bg-secondary font-medium text-foreground" : "text-muted-foreground hover:text-foreground",
];
const heading = "mb-1 px-2.5 font-mono text-[11px] tracking-wider text-muted-foreground/80 uppercase";
const pager = "group flex min-w-0 flex-col gap-1 rounded-xl border bg-card p-4 transition-colors hover:border-primary/40 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none";
---

<Site title={title} description={description}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:grid lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-10 xl:grid-cols-[14rem_minmax(0,1fr)_12rem]">
    <aside class="hidden lg:sticky lg:top-14 lg:block lg:max-h-[calc(100dvh-3.5rem)] lg:self-start lg:overflow-y-auto lg:py-10" aria-label="Guides">
      <nav class="grid gap-8">
        {nav.map((group) => (
          <div>
            <p class={heading}>{group.label}</p>
            <ul class="grid gap-0.5">
              {group.items.map((item) => <li><a href={item.href} class:list={link(item)} aria-current={item.href === pathname ? "page" : undefined}>{item.label}</a></li>)}
            </ul>
            {group.frameworks.length > 0 && (
              <ul class="mt-2 ml-2.5 grid gap-0.5 border-l pl-2">
                {group.frameworks.map((item) => <li><a href={item.href} class:list={link(item)} aria-current={item.href === pathname ? "page" : undefined}>{item.label}</a></li>)}
              </ul>
            )}
          </div>
        ))}
      </nav>
    </aside>

    <main class="min-w-0 pt-8 pb-24 lg:pt-10">
      <details class="group mb-8 rounded-lg border bg-card lg:hidden">
        <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-2.5 text-sm [&::-webkit-details-marker]:hidden">
          <span><span class="text-muted-foreground">{section?.label ?? "Guides"} /</span> {title}</span>
          <ChevronDown className="size-4 text-muted-foreground transition-transform group-open:rotate-180" />
        </summary>
        <nav class="grid gap-6 border-t px-2 py-4" aria-label="Guides">
          {nav.map((group) => (
            <div>
              <p class={heading}>{group.label}</p>
              <ul class="grid gap-0.5">
                {group.items.concat(group.frameworks).map((item) => <li><a href={item.href} class:list={link(item)}>{item.label}</a></li>)}
              </ul>
            </div>
          ))}
        </nav>
      </details>

      <article>
        <p class="font-mono text-xs text-muted-foreground">{section?.label ?? "Guides"}</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{title}</h1>
        {description && <p class="mt-3 text-lg text-pretty text-muted-foreground">{description}</p>}
        <div class="guide-prose mt-8">
          <slot />
        </div>
      </article>

      <nav aria-label="Previous and next" class="mt-16 grid gap-4 border-t pt-8 sm:grid-cols-2">
        {previous
          ? (
            <a href={previous.href} class={pager}>
              <span class="flex items-center gap-1.5 text-xs text-muted-foreground"><ArrowLeft className="size-3.5" /> Previous</span>
              <span class="font-medium">{previous.label}</span>
            </a>
          )
          : <span class="hidden sm:block"></span>}
        {next && (
          <a href={next.href} class:list={[pager, "sm:items-end sm:text-right"]}>
            <span class="flex items-center gap-1.5 text-xs text-muted-foreground">Next <ArrowRight className="size-3.5" /></span>
            <span class="font-medium">{next.label}</span>
          </a>
        )}
      </nav>
    </main>

    {toc.length > 0 && (
      <aside class="hidden xl:sticky xl:top-14 xl:block xl:max-h-[calc(100dvh-3.5rem)] xl:self-start xl:overflow-y-auto xl:py-10" aria-label="On this page">
        <p class="mb-3 text-xs font-medium">On this page</p>
        <ul class="grid gap-1.5 border-l text-sm" data-toc>
          {toc.map((entry) => (
            <li>
              <a
                href={`#${entry.slug}`}
                class:list={["-ml-px block border-l border-transparent text-muted-foreground transition-colors hover:text-foreground data-active:border-primary data-active:text-foreground", entry.depth === 3 ? "pl-6" : "pl-3"]}
                data-toc-link={entry.slug}
              >
                {entry.text}
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </div>
</Site>

<script>
  import { initGuide } from "@/lib/guide-page";

  initGuide(document);
</script>
