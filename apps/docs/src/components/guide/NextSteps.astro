---
interface Props {
  title?: string;
}

const { title = "Next steps" } = Astro.props;
---

<nav class="not-prose mt-10" aria-label={title}>
  <p class="mb-2 font-mono text-[11px] tracking-wider text-muted-foreground uppercase">{title}</p>
  <ul class="my-0 list-none divide-y border-y pl-0">
    <slot />
  </ul>
</nav>
