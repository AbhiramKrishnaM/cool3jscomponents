---
interface SchemaEntry {
  key: string;
  label: string;
  group: string;
  description: string;
  live: boolean;
  type: "number" | "boolean" | "color" | "select";
  default: unknown;
  min?: number;
  max?: number;
  step?: number;
  choices?: readonly string[];
  standaloneOnly?: boolean;
}

interface Props {
  schema: readonly SchemaEntry[];
  showLive?: boolean;
  emptyColor?: string;
}

const { schema, showLive = true, emptyColor = "inherit" } = Astro.props;
const groups = [...new Set(schema.map((entry) => entry.group))].map((group) => ({
  group,
  entries: schema.filter((entry) => entry.group === group),
}));

const slug = (group: string): string => `options-${group.toLowerCase().replace(/\s+/g, "-")}`;

function typeOf(entry: SchemaEntry): string {
  if (entry.type === "select") return (entry.choices ?? []).map((choice) => `"${choice}"`).join(" | ");
  if (entry.type === "number") return `number, ${entry.min}–${entry.max}`;
  return entry.type;
}

function defaultOf(entry: SchemaEntry): string | null {
  if (entry.type === "color" && entry.default === "") return null;
  if (typeof entry.default === "string") return `"${entry.default}"`;
  return String(entry.default);
}
---

<nav class="options-index" aria-label="Option groups">
  {groups.map(({ group }) => <a href={`#${slug(group)}`}>{group}</a>)}
</nav>

{groups.map(({ group, entries }) => (
  <section class="options-group">
    <h3 id={slug(group)}>{group}</h3>
    <table>
      <thead>
        <tr>
          <th>Option</th>
          <th>Default</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        {entries.map((entry) => {
          const value = defaultOf(entry);
          return (
            <tr>
              <td class="option">
                <code>{entry.key}</code>
                <span class="meta">
                  {typeOf(entry)}
                  {showLive && !entry.live && " · rebuild"}
                  {entry.standaloneOnly && " · standalone only"}
                </span>
              </td>
              <td class="default">
                {entry.type === "color" && entry.default !== "" && <span class="swatch" style={`background:${entry.default}`} />}
                {value === null ? <em>{emptyColor}</em> : <code>{value}</code>}
              </td>
              <td>{entry.description}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </section>
))}

<style>
  .options-index {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    font-size: var(--sl-text-sm);
  }

  .options-group table {
    display: table;
    width: 100%;
  }

  .option code {
    white-space: nowrap;
  }

  .meta {
    display: block;
    margin-top: 0.35rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    white-space: nowrap;
  }

  .default {
    white-space: nowrap;
  }

  @media (max-width: 50rem) {
    .options-group table,
    .options-group tbody,
    .options-group tr,
    .options-group td {
      display: block;
      width: 100%;
    }

    .options-group thead {
      display: none;
    }

    .options-group tr {
      padding-block: 0.75rem;
      border-bottom: 1px solid var(--sl-color-gray-5);
    }

    .options-group td {
      border: none;
      padding: 0.15rem 0;
    }

    .options-group td.default::before {
      content: "default ";
      color: var(--sl-color-gray-3);
      font-size: var(--sl-text-xs);
    }
  }

  .swatch {
    display: inline-block;
    width: 0.8em;
    height: 0.8em;
    margin-inline-end: 0.35em;
    border-radius: 2px;
    border: 1px solid var(--sl-color-gray-5);
    vertical-align: -0.05em;
  }
</style>
