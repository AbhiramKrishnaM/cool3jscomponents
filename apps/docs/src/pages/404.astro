---
import { ArrowRight } from "lucide-react";
import Site from "@/layouts/Site.astro";
---

<Site title="Page not found" noindex>
  <main class="mx-auto flex max-w-xl flex-col items-start px-4 py-32 sm:px-6">
    <p class="font-mono text-xs text-muted-foreground">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">This page drifted off the grid.</h1>
    <p class="mt-3 text-muted-foreground">The link may be old, or the page has moved. Try the search, or start from the components.</p>
    <a href="/components/" class="mt-8 inline-flex h-10 items-center gap-2 rounded-md bg-primary px-5 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none">
      Browse components <ArrowRight className="size-4" />
    </a>
  </main>
</Site>
