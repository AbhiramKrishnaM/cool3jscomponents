{
  "name": "@abhiramkrishna/contribution-skyline",
  "version": "0.0.0",
  "description": "GitHub contributions rendered as glowing three.js bars, standalone or as a spacetime-grid layer.",
  "license": "MIT",
  "author": "Abhiram Krishna M",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "three": ">=0.160.0",
    "@abhiramkrishna/spacetime-grid": "workspace:^"
  },
  "devDependencies": {
    "@abhiramkrishna/spacetime-grid": "workspace:*",
    "@types/three": "^0.186.0",
    "three": "^0.186.1",
    "tsup": "~8.5.1",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@abhiramkrishna/spacetime-grid": {
      "optional": true
    }
  }
}
