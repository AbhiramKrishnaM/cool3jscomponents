{
  "name": "@abhiramkrishna/contribution-skyline",
  "version": "0.1.0",
  "description": "GitHub contributions rendered as glowing three.js bars, standalone or as a spacetime-grid layer.",
  "license": "MIT",
  "author": "Abhiram Krishna M",
  "keywords": [
    "three",
    "threejs",
    "webgl",
    "github",
    "contributions",
    "calendar",
    "chart",
    "data-visualization",
    "vue",
    "react",
    "web-component"
  ],
  "homepage": "https://github.com/AbhiramKrishnaM/cool3jscomponents/tree/master/packages/contribution-skyline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbhiramKrishnaM/cool3jscomponents.git",
    "directory": "packages/contribution-skyline"
  },
  "bugs": {
    "url": "https://github.com/AbhiramKrishnaM/cool3jscomponents/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "import": "./dist/fetch.js"
    },
    "./calendar": {
      "types": "./dist/calendar.d.ts",
      "import": "./dist/calendar.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "three": ">=0.160.0",
    "vue": ">=3.3.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "three": "^0.186.1",
    "tsup": "~8.5.1",
    "typescript": "~6.0.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "vue": "3.5.43"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@abhiramkrishna/spacetime-grid": "workspace:^"
  },
  "bin": {
    "contribution-skyline-fetch": "./dist/cli.js"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
